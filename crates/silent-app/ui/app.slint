import { Button, LineEdit, ComboBox, CheckBox, ListView, ScrollView } from "std-widgets.slint";

export struct Tile {
    key: string,
    name: string,
    initial: string,
    kind: string,
    frame: image,
    has-video: bool,
    mic: bool,
    status: string,
    is-me: bool,
    /// You compared safety words with them and they matched.
    confirmed: bool,
    speaking: bool,
    muted-for-me: bool,
    /// How loud they play for you, in percent (100 is normal).
    volume: int,
    /// Their connection is losing audio or lagging.
    poor-connection: bool,
}

export struct ChatLine {
    who: string,
    text: string,
    time: string,
    mine: bool,
    system: bool,
    /// Set for a file: identifies it for saving.
    file: string,
    /// Ready to save (fully received, or sent by you).
    file-ready: bool,
    has-image: bool,
    image: image,
}

export struct SourceItem {
    id: string,
    title: string,
}

export struct Verification {
    peer: int,
    name: string,
    words: string,
    /// You told the app the words matched.
    confirmed: bool,
}

export global Palette {
    out property <color> bg: #070707;
    out property <color> panel: #101010;
    out property <color> card: #171717;
    out property <color> card-hover: #221214;
    out property <color> border: #2a1a1c;
    out property <color> text: #f2f2f2;
    out property <color> subtext: #a3a3a3;
    out property <color> accent: #e11d2e;
    out property <color> accent-dim: #4a0f16;
    out property <color> ok: #3fb67a;
    out property <color> danger: #9b111e;
}

/// 0 to 200 percent in steps of 5, in the app's colours.
component VolumeSlider inherits Rectangle {
    in-out property <int> value;
    callback changed(int);
    min-width: 90px;
    track := Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: #ffffff40;
    }
    Rectangle {
        x: 0;
        y: track.y;
        width: knob.x + knob.width / 2;
        height: track.height;
        border-radius: 2px;
        background: Palette.accent;
    }
    knob := Rectangle {
        x: (parent.width - self.width) * min(root.value, 200) / 200;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: Palette.text;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.pick(self.mouse-x);
            }
        }
        moved => { if (self.pressed) { root.pick(self.mouse-x); } }
    }
    function pick(x: length) {
        root.value = Math.round(max(0, min(1, (x - knob.width / 2) / (root.width - knob.width))) * 40) * 5;
        root.changed(root.value);
    }
}

component PillButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked;
    height: 40px;
    min-width: 96px;
    border-radius: 20px;
    background: !enabled ? Palette.card : danger ? Palette.danger : active ? Palette.accent : touch.has-hover ? Palette.card-hover : Palette.card;
    border-width: 1px;
    border-color: active || danger ? transparent : Palette.border;
    opacity: enabled ? 1.0 : 0.5;
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        Text {
            text: root.label;
            color: Palette.text;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component VideoTile inherits Rectangle {
    in property <Tile> tile;
    in property <bool> small: false;
    callback clicked;
    callback double-clicked;
    callback mute-toggled;
    callback volume-changed(int);
    border-radius: small ? 8px : 12px;
    clip: true;
    background: Palette.card;
    border-width: tile.speaking ? 3px : 1px;
    border-color: tile.speaking ? Palette.ok : touch.has-hover ? Palette.accent-dim : Palette.border;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
    }

    if tile.has-video: Image {
        width: parent.width;
        height: parent.height;
        source: tile.frame;
        image-fit: tile.kind == "screen" ? contain : cover;
    }

    // Over a frozen picture while the connection recovers.
    if tile.has-video && tile.status != "": Rectangle {
        background: #000000a0;
        Text {
            text: tile.status;
            color: Palette.text;
            font-size: root.small ? 11px : 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if !tile.has-video: VerticalLayout {
        alignment: center;
        spacing: 10px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: root.small ? 36px : 72px;
                height: self.width;
                border-radius: self.width / 2;
                background: Palette.accent-dim;
                Text {
                    text: tile.initial;
                    color: Palette.text;
                    font-size: root.small ? 16px : 28px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        if tile.status != "" && !root.small: Text {
            text: tile.status;
            color: Palette.subtext;
            font-size: 13px;
            horizontal-alignment: center;
        }
    }

    Rectangle {
        x: root.small ? 6px : 10px;
        y: parent.height - self.height - (root.small ? 6px : 10px);
        height: root.small ? 20px : 26px;
        width: min(label.preferred-width + 20px, parent.width - 2 * self.x);
        border-radius: self.height / 2;
        background: !tile.mic && tile.kind != "screen" ? #9b111ed0 : #000000b0;
        label := Text {
            x: 10px;
            width: parent.width - 20px;
            text: (tile.mic || tile.kind == "screen" ? "" : "muted  ·  ") + tile.name + (tile.kind == "screen" ? "'s screen" : "") + (tile.is-me ? " (you)" : "") + (tile.confirmed && tile.kind == "camera" ? "  ·  verified" : "") + (tile.poor-connection && tile.kind == "camera" ? "  ·  weak connection" : "");
            color: Palette.text;
            font-size: root.small ? 11px : 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // Mute a friend or change their volume, for yourself only.
    TouchArea {
        visible: !tile.is-me && tile.kind == "camera" && !root.small && (touch.has-hover || self.has-hover || tile.muted-for-me);
        x: parent.width - self.width - 10px;
        y: 10px;
        width: 170px;
        height: column.preferred-height;
        // Clicks beside the controls still belong to the tile.
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
        column := VerticalLayout {
            spacing: 6px;
            alignment: start;
            HorizontalLayout {
                alignment: end;
                Rectangle {
                    height: 26px;
                    width: mute-label.preferred-width + 20px;
                    border-radius: 13px;
                    background: tile.muted-for-me ? Palette.danger : mute.has-hover ? #000000e0 : #000000b0;
                    mute-label := Text {
                        text: tile.muted-for-me ? "Muted for you" : "Mute for me";
                        color: Palette.text;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                    mute := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.mute-toggled(); }
                    }
                }
            }
            if !tile.muted-for-me: Rectangle {
                height: 30px;
                border-radius: 15px;
                background: #000000b0;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 8px;
                    spacing: 6px;
                    Text {
                        text: volume.value + "%";
                        width: 34px;
                        color: Palette.text;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    volume := VolumeSlider {
                        value: tile.volume;
                        changed(v) => { root.volume-changed(v); }
                    }
                }
            }
        }
    }
}

component DevicePickers inherits VerticalLayout {
    in property <[string]> microphones;
    in property <[string]> speakers;
    in property <[string]> cameras;
    in-out property <int> microphone;
    in-out property <int> speaker;
    in-out property <int> camera;
    callback changed;
    spacing: 10px;
    Text { text: "Microphone"; color: Palette.subtext; font-size: 12px; }
    ComboBox {
        model: root.microphones;
        current-index <=> root.microphone;
        selected => { root.changed(); }
    }
    Text { text: "Speaker"; color: Palette.subtext; font-size: 12px; }
    ComboBox {
        model: root.speakers;
        current-index <=> root.speaker;
        selected => { root.changed(); }
    }
    Text { text: "Camera"; color: Palette.subtext; font-size: 12px; }
    ComboBox {
        model: root.cameras;
        current-index <=> root.camera;
        selected => { root.changed(); }
    }
}

component Home inherits Rectangle {
    in-out property <string> name;
    in-out property <string> join-code;
    in property <string> error;
    in property <bool> busy;
    in-out property <int> camera-quality;
    in-out property <int> screen-quality;
    in-out property <bool> relay-only;
    in-out property <bool> push-to-talk;
    in-out property <bool> sounds;
    in-out property <string> relay-url;
    in property <[string]> microphones;
    in property <[string]> speakers;
    in property <[string]> cameras;
    in-out property <int> microphone;
    in-out property <int> speaker;
    in-out property <int> camera;
    property <bool> show-settings: false;
    callback create-room;
    callback join-room;
    callback devices-requested;
    callback devices-changed;

    background: Palette.bg;

    scroll := ScrollView {
        content-width: scroll.visible-width;
        content-height: max(scroll.visible-height, form.preferred-height + 80px);
            form := VerticalLayout {
                x: (scroll.visible-width - self.width) / 2;
                y: max(40px, (scroll.visible-height - self.preferred-height) / 2);
                width: 420px;
                height: self.preferred-height;
                spacing: 16px;

                Text {
                    text: "Silent";
                    color: Palette.text;
                    font-size: 44px;
                    font-weight: 800;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Encrypted calls, screen sharing and chat for up to four friends.\nNo accounts. Nothing stored.";
                    color: Palette.subtext;
                    font-size: 14px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Rectangle { height: 8px; }

                Text { text: "Your name"; color: Palette.subtext; font-size: 12px; }
                LineEdit {
                    text <=> root.name;
                    placeholder-text: "What friends will see";
                }

                PillButton {
                    label: root.busy ? "Connecting…" : "Start a room";
                    active: true;
                    enabled: !root.busy;
                    clicked => { root.create-room(); }
                }

                HorizontalLayout {
                    spacing: 10px;
                    Rectangle { height: 1px; background: Palette.border; y: 8px; }
                    Text { text: "or join a friend"; color: Palette.subtext; font-size: 12px; }
                    Rectangle { height: 1px; background: Palette.border; y: 8px; }
                }

                HorizontalLayout {
                    spacing: 10px;
                    LineEdit {
                        text <=> root.join-code;
                        placeholder-text: "1234-word-word-word";
                        accepted => { root.join-room(); }
                    }
                    PillButton {
                        label: "Join";
                        enabled: !root.busy && root.join-code != "";
                        clicked => { root.join-room(); }
                    }
                }

                if root.error != "": Text {
                    text: root.error;
                    color: Palette.danger;
                    font-size: 13px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.show-settings ? "Hide settings" : "Settings";
                    color: Palette.accent;
                    font-size: 13px;
                    horizontal-alignment: center;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.show-settings = !root.show-settings;
                            if (root.show-settings) {
                                root.devices-requested();
                            }
                        }
                    }
                }

                if root.show-settings: VerticalLayout {
                    spacing: 10px;
                    Text { text: "Camera quality"; color: Palette.subtext; font-size: 12px; }
                    ComboBox {
                        model: ["Standard (720p, 30 fps)", "High (1080p, 60 fps)"];
                        current-index <=> root.camera-quality;
                    }
                    Text { text: "Screen share"; color: Palette.subtext; font-size: 12px; }
                    ComboBox {
                        model: ["Motion: games and video (1080p, 60 fps)", "Detail: code and documents (1440p, 30 fps)"];
                        current-index <=> root.screen-quality;
                    }
                    CheckBox {
                        text: "Hide my IP from friends (relay all media)";
                        checked <=> root.relay-only;
                    }
                    CheckBox {
                        text: "Push to talk: hold Space to speak";
                        checked <=> root.push-to-talk;
                    }
                    CheckBox {
                        text: "Play a sound when friends join or leave";
                        checked <=> root.sounds;
                    }
                    Text { text: "Relay server"; color: Palette.subtext; font-size: 12px; }
                    LineEdit { text <=> root.relay-url; }
                    DevicePickers {
                        microphones: root.microphones;
                        speakers: root.speakers;
                        cameras: root.cameras;
                        microphone <=> root.microphone;
                        speaker <=> root.speaker;
                        camera <=> root.camera;
                        changed => { root.devices-changed(); }
                    }
                }
            }
    }
}

component Room inherits Rectangle {
    in property <string> code;
    in property <[Tile]> tiles;
    in property <[ChatLine]> chat;
    in property <[Verification]> verifications;
    in property <bool> mic-on;
    in property <bool> camera-on;
    in property <bool> screen-on;
    in property <bool> copied;
    in property <string> notice;
    /// Index of the spotlighted tile, or -1 for the grid.
    in property <int> focus-index: -1;
    in property <bool> immersive: false;
    in property <bool> push-to-talk: false;
    in-out property <string> draft;
    callback tile-clicked(string);
    callback mute-friend(string);
    callback friend-volume(string, int);
    callback toggle-fullscreen;
    callback toggle-mic;
    callback toggle-camera;
    callback toggle-screen;
    callback leave;
    callback copy-code;
    callback send-chat;
    callback send-file;
    callback save-file(string);
    callback show-verify;
    callback show-stats;
    callback show-devices;

    background: Palette.bg;

    property <int> count: tiles.length;
    property <int> cols: count <= 1 ? 1 : count <= 4 ? 2 : 3;
    property <int> rows: Math.ceil(count / cols);
    property <length> gap: 12px;

    VerticalLayout {
        if !root.immersive: HorizontalLayout {
            height: 56px;
            padding-left: 16px;
            padding-right: 16px;
            spacing: 12px;
            Text {
                text: "Silent";
                color: Palette.text;
                font-size: 18px;
                font-weight: 800;
                vertical-alignment: center;
            }
            Rectangle {
                height: 34px;
                y: 11px;
                border-radius: 17px;
                background: Palette.card;
                width: code-row.preferred-width + 24px;
                code-row := HorizontalLayout {
                    padding-left: 12px;
                    spacing: 8px;
                    Text { text: "Room code"; color: Palette.subtext; font-size: 12px; vertical-alignment: center; }
                    Text { text: root.code; color: Palette.text; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                    Text {
                        text: root.copied ? "Copied" : "Copy";
                        color: Palette.accent;
                        font-size: 12px;
                        vertical-alignment: center;
                        TouchArea { mouse-cursor: pointer; clicked => { root.copy-code(); } }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            if root.notice != "": Text {
                text: root.notice;
                color: Palette.subtext;
                font-size: 12px;
                vertical-alignment: center;
            }
            PillButton {
                y: 8px;
                label: "Devices";
                clicked => { root.show-devices(); }
            }
            PillButton {
                y: 8px;
                label: "Stats";
                enabled: root.verifications.length > 0;
                clicked => { root.show-stats(); }
            }
            PillButton {
                y: 8px;
                label: "Verify";
                enabled: root.verifications.length > 0;
                clicked => { root.show-verify(); }
            }
        }

        HorizontalLayout {
            padding: 12px;
            spacing: 12px;

            stage := Rectangle {
                horizontal-stretch: 1;
                property <length> cell-w: (self.width - (root.cols - 1) * root.gap) / root.cols;
                property <length> cell-h: (self.height - (root.rows - 1) * root.gap) / max(root.rows, 1);
                property <length> tile-w: min(self.cell-w, self.cell-h * 16 / 9);
                property <length> tile-h: self.tile-w * 9 / 16;
                property <length> x0: (self.width - root.cols * self.tile-w - (root.cols - 1) * root.gap) / 2;
                property <length> y0: (self.height - root.rows * self.tile-h - (root.rows - 1) * root.gap) / 2;
                // Spotlight: one big tile, the others in a strip below it.
                property <bool> spotlight: root.focus-index >= 0 && root.focus-index < root.count;
                property <int> others: root.count - 1;
                property <length> thumb-h: self.others > 0 ? min(110px, self.height / 5) : 0px;
                property <length> thumb-w: min(self.thumb-h * 16 / 9, (self.width - max(self.others - 1, 0) * root.gap) / max(self.others, 1));
                property <length> strip-x0: (self.width - self.others * self.thumb-w - max(self.others - 1, 0) * root.gap) / 2;
                property <length> big-area-h: self.height - (self.others > 0 ? self.thumb-h + root.gap : 0px);
                property <length> big-w: min(self.width, self.big-area-h * 16 / 9);
                property <length> big-h: self.big-w * 9 / 16;
                for t[i] in root.tiles: VideoTile {
                    property <bool> big: stage.spotlight && i == root.focus-index;
                    property <int> slot: i < root.focus-index ? i : i - 1;
                    tile: t;
                    small: stage.spotlight && !self.big;
                    x: !stage.spotlight ? stage.x0 + Math.mod(i, root.cols) * (stage.tile-w + root.gap)
                        : self.big ? (stage.width - stage.big-w) / 2
                        : stage.strip-x0 + self.slot * (stage.thumb-w + root.gap);
                    y: !stage.spotlight ? stage.y0 + Math.floor(i / root.cols) * (stage.tile-h + root.gap)
                        : self.big ? (stage.big-area-h - stage.big-h) / 2
                        : stage.height - stage.thumb-h;
                    width: !stage.spotlight ? stage.tile-w : self.big ? stage.big-w : stage.thumb-w;
                    height: !stage.spotlight ? stage.tile-h : self.big ? stage.big-h : stage.thumb-h;
                    clicked => { root.tile-clicked(t.key); }
                    double-clicked => { root.toggle-fullscreen(); }
                    mute-toggled => { root.mute-friend(t.key); }
                    volume-changed(v) => { root.friend-volume(t.key, v); }
                }
            }

            if !root.immersive: Rectangle {
                width: 300px;
                border-radius: 12px;
                background: Palette.panel;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Text { text: "Chat"; color: Palette.text; font-size: 14px; font-weight: 700; }
                    Text {
                        text: "End-to-end encrypted. Gone when you leave.";
                        color: Palette.subtext;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    ListView {
                        vertical-stretch: 1;
                        for line in root.chat: VerticalLayout {
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 2px;
                            if !line.system: HorizontalLayout {
                                alignment: start;
                                spacing: 6px;
                                Text { text: line.who; color: line.mine ? Palette.accent : Palette.text; font-size: 12px; font-weight: 700; }
                                Text { text: line.time; color: Palette.subtext; font-size: 11px; }
                            }
                            Text {
                                text: line.text;
                                color: line.system ? Palette.subtext : Palette.text;
                                font-size: line.system ? 12px : 13px;
                                font-italic: line.system;
                                wrap: word-wrap;
                            }
                            if line.has-image: Image {
                                source: line.image;
                                width: min(self.source.width * 1px, 260px);
                                height: self.width * self.source.height / max(self.source.width, 1);
                                image-fit: contain;
                            }
                            if line.file != "" && line.file-ready && !line.mine: Text {
                                text: "Save…";
                                color: Palette.accent;
                                font-size: 12px;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.save-file(line.file); }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        LineEdit {
                            text <=> root.draft;
                            placeholder-text: "Message";
                            accepted => { root.send-chat(); }
                        }
                        Rectangle {
                            width: 36px;
                            border-radius: 6px;
                            background: attach.has-hover ? Palette.card-hover : Palette.card;
                            Text { text: "+"; color: Palette.text; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
                            attach := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.send-file(); }
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            height: 72px;
            alignment: center;
            spacing: 12px;
            padding-bottom: 16px;
            PillButton { label: root.mic-on ? "Mute" : "Unmute"; active: !root.mic-on; clicked => { root.toggle-mic(); } }
            PillButton { label: root.camera-on ? "Stop camera" : "Camera"; active: root.camera-on; clicked => { root.toggle-camera(); } }
            PillButton { label: root.screen-on ? "Stop sharing" : "Share screen"; active: root.screen-on; clicked => { root.toggle-screen(); } }
            PillButton { label: root.immersive ? "Exit full screen" : "Full screen"; clicked => { root.toggle-fullscreen(); } }
            PillButton { label: "Leave"; danger: true; clicked => { root.leave(); } }
        }
        if !root.immersive: Text {
            height: 20px;
            text: (root.push-to-talk ? "Hold Space to talk  ·  " : "") + "Click a tile to spotlight it  ·  Ctrl+D mute  ·  Ctrl+E camera  ·  F11 full screen";
            color: Palette.subtext;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: top;
        }
    }
}

component Sheet inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    callback close;
    background: #000000a0;
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        width: min(460px, root.width - 40px);
        height: min(content.preferred-height, root.height - 80px);
        border-radius: 14px;
        background: Palette.panel;
        border-width: 1px;
        border-color: Palette.border;
        TouchArea {}
        content := VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text { text: root.title; color: Palette.text; font-size: 18px; font-weight: 700; }
            if root.subtitle != "": Text { text: root.subtitle; color: Palette.subtext; font-size: 13px; wrap: word-wrap; }
            @children
        }
    }
}

export component AppWindow inherits Window {
    title: "Silent";
    icon: @image-url("../../../packaging/silent.png");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 600px;
    background: Palette.bg;
    default-font-size: 14px;

    in-out property <string> screen: "home";

    in-out property <string> name;
    in-out property <string> join-code;
    in property <string> home-error;
    in property <bool> busy;
    in-out property <int> camera-quality: 0;
    in-out property <int> screen-quality: 0;
    in-out property <bool> relay-only: false;
    in-out property <bool> push-to-talk: false;
    in-out property <bool> sounds: true;
    /// A file is being dragged over the window.
    in property <bool> dropping;
    in-out property <string> relay-url;

    in property <string> code;
    in property <[Tile]> tiles;
    in property <[ChatLine]> chat;
    in property <[Verification]> verifications;
    in property <bool> mic-on: true;
    in property <bool> camera-on;
    in property <bool> screen-on;
    in property <bool> copied;
    in property <string> notice;
    in property <int> focus-index: -1;
    in-out property <string> draft;

    in property <[SourceItem]> sources;
    in-out property <bool> picker-open: false;
    in-out property <bool> verify-open: false;
    in-out property <bool> stats-open: false;
    in property <[string]> stats-lines;
    in-out property <bool> devices-open: false;
    in property <[string]> microphones: ["System default"];
    in property <[string]> speakers: ["System default"];
    in property <[string]> cameras: ["First camera"];
    in-out property <int> microphone: 0;
    in-out property <int> speaker: 0;
    in-out property <int> camera: 0;

    callback create-room;
    callback join-room;
    callback toggle-mic;
    callback toggle-camera;
    callback toggle-screen;
    callback pick-source(string);
    callback leave;
    callback copy-code;
    callback send-chat;
    callback send-file;
    callback save-file(string);
    callback stats-opened;
    callback tile-clicked(string);
    callback mute-friend(string);
    callback friend-volume(string, int);
    callback unfocus-tile;
    callback confirm-words(int);
    callback push-to-talk-held(bool);
    callback devices-requested;
    callback devices-changed;

    if root.screen == "home": Home {
        name <=> root.name;
        join-code <=> root.join-code;
        error: root.home-error;
        busy: root.busy;
        camera-quality <=> root.camera-quality;
        screen-quality <=> root.screen-quality;
        relay-only <=> root.relay-only;
        push-to-talk <=> root.push-to-talk;
        sounds <=> root.sounds;
        relay-url <=> root.relay-url;
        microphones: root.microphones;
        speakers: root.speakers;
        cameras: root.cameras;
        microphone <=> root.microphone;
        speaker <=> root.speaker;
        camera <=> root.camera;
        create-room => { root.create-room(); }
        join-room => { root.join-room(); }
        devices-requested => { root.devices-requested(); }
        devices-changed => { root.devices-changed(); }
    }

    if root.screen == "room": keys := FocusScope {
      init => { self.focus(); }
      capture-key-pressed(event) => {
        if (event.modifiers.control && (event.text == "d" || event.text == "D")) {
            root.toggle-mic();
            return accept;
        }
        if (event.modifiers.control && (event.text == "e" || event.text == "E")) {
            root.toggle-camera();
            return accept;
        }
        if (event.text == Key.F11) {
            root.full-screen = !root.full-screen;
            return accept;
        }
        if (event.text == Key.Escape && !root.picker-open && !root.verify-open && !root.stats-open && !root.devices-open) {
            if (root.full-screen) {
                root.full-screen = false;
                return accept;
            }
            if (root.focus-index >= 0) {
                root.unfocus-tile();
                return accept;
            }
            // Out of the chat box, so Space works for push to talk.
            self.focus();
            return accept;
        }
        reject
      }
      // Only keys nobody else took get here, so typing a space in the chat
      // box never talks.
      key-pressed(event) => {
        if (root.push-to-talk && event.text == " ") {
            if (!event.repeat) {
                root.push-to-talk-held(true);
            }
            return accept;
        }
        reject
      }
      key-released(event) => {
        if (root.push-to-talk && event.text == " ") {
            root.push-to-talk-held(false);
            return accept;
        }
        reject
      }
      // No key-released comes once the window loses focus; don't leave the
      // microphone open.
      focus-lost(reason) => {
        if (root.push-to-talk) {
            root.push-to-talk-held(false);
        }
      }
      Room {
        code: root.code;
        tiles: root.tiles;
        chat: root.chat;
        verifications: root.verifications;
        mic-on: root.mic-on;
        camera-on: root.camera-on;
        screen-on: root.screen-on;
        copied: root.copied;
        notice: root.notice;
        draft <=> root.draft;
        toggle-mic => { root.toggle-mic(); }
        toggle-camera => { root.toggle-camera(); }
        toggle-screen => { root.toggle-screen(); }
        leave => { root.leave(); }
        copy-code => { root.copy-code(); }
        send-chat => { root.send-chat(); }
        send-file => { root.send-file(); }
        save-file(id) => { root.save-file(id); }
        show-verify => { root.verify-open = true; }
        show-devices => {
            root.devices-open = true;
            root.devices-requested();
        }
        show-stats => {
            root.stats-open = true;
            root.stats-opened();
        }
        focus-index: root.focus-index;
        immersive: root.full-screen;
        push-to-talk: root.push-to-talk;
        tile-clicked(key) => {
            keys.focus();
            root.tile-clicked(key);
        }
        mute-friend(key) => { root.mute-friend(key); }
        friend-volume(key, v) => { root.friend-volume(key, v); }
        toggle-fullscreen => { root.full-screen = !root.full-screen; }
      }
    }

    if root.picker-open: Sheet {
        title: "Share your screen";
        subtitle: "Friends see it at up to 60 fps. Only people in this room can watch.";
        close => { root.picker-open = false; }
        ScrollView {
            min-height: min(root.sources.length * 46px, 320px);
            VerticalLayout {
                spacing: 6px;
                for s in root.sources: Rectangle {
                    height: 40px;
                    border-radius: 8px;
                    background: ta.has-hover ? Palette.card-hover : Palette.card;
                    Text {
                        x: 12px;
                        width: parent.width - 24px;
                        text: s.title;
                        color: Palette.text;
                        overflow: elide;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                    ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.picker-open = false;
                            root.pick-source(s.id);
                        }
                    }
                }
            }
        }
        PillButton { label: "Cancel"; clicked => { root.picker-open = false; } }
    }

    if root.verify-open: Sheet {
        title: "Check for eavesdroppers";
        subtitle: "Read your words aloud with each friend. If they match, your connection is end to end and nobody is listening in. If they differ, leave the room.";
        close => { root.verify-open = false; }
        for v in root.verifications: HorizontalLayout {
            spacing: 12px;
            Text { text: v.name; color: Palette.subtext; width: 120px; overflow: elide; vertical-alignment: center; }
            Text { text: v.words; color: Palette.text; font-size: 16px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
            Text {
                text: v.confirmed ? "Verified" : "They match";
                color: v.confirmed ? Palette.ok : Palette.accent;
                font-size: 13px;
                vertical-alignment: center;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.confirm-words(v.peer); }
                }
            }
        }
        PillButton { label: "Done"; clicked => { root.verify-open = false; } }
    }

    if root.devices-open: Sheet {
        title: "Devices";
        subtitle: "Switching takes effect right away.";
        close => { root.devices-open = false; }
        DevicePickers {
            microphones: root.microphones;
            speakers: root.speakers;
            cameras: root.cameras;
            microphone <=> root.microphone;
            speaker <=> root.speaker;
            camera <=> root.camera;
            changed => { root.devices-changed(); }
        }
        PillButton { label: "Done"; clicked => { root.devices-open = false; } }
    }

    if root.stats-open: Sheet {
        title: "Call quality";
        subtitle: "Live numbers for each friend, refreshed every second.";
        close => { root.stats-open = false; }
        for line in root.stats-lines: Text {
            text: line;
            color: Palette.text;
            font-size: 12px;
            wrap: word-wrap;
        }
        PillButton { label: "Done"; clicked => { root.stats-open = false; } }
    }

    if root.screen == "room" && root.dropping: Rectangle {
        background: #000000c8;
        Rectangle {
            x: 24px;
            y: 24px;
            width: parent.width - 48px;
            height: parent.height - 48px;
            border-radius: 16px;
            border-width: 2px;
            border-color: Palette.accent;
            Text {
                text: "Drop to send to everyone in the room";
                color: Palette.text;
                font-size: 20px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
